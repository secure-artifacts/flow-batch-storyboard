{
  "manifest_version": 3,
  "name": "FLOW分镜批量-3.0.30-Chrome",
  "description": "按分镜表批量生成 Flow 视频，支持按文件名匹配图片、断点续作、温和分轮补跑与严格命名下载",
  "version": "3.0.30",
  "author": "小羊",
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "js": [
        "diagnostics/network-protocol-bridge.js"
      ],
      "matches": [
        "https://flow.google.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "transformers/angular-direct.js",
        "transformers/flow.js",
        "transformers/disablePageFreeze.js"
      ],
      "matches": [
        "https://labs.google/fx/zh/tools/flow",
        "https://labs.google/fx/zh/tools/flow/project/*",
        "https://flow.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "assets/index.ts-loader-DJMxT1XF.js"
      ],
      "matches": [
        "https://labs.google/fx/zh/tools/flow",
        "https://labs.google/fx/zh/tools/flow/project/*",
        "https://flow.google.com/*"
      ],
      "run_at": "document_end"
    },
    {
      "css": [
        "injects/index.css"
      ],
      "js": [
        "checkpoint-v2.js",
        "run-logger.js",
        "trusted-types.js",
        "externals.js",
        "native-flow-bridge.js",
        "injects/index.js"
      ],
      "matches": [
        "https://labs.google/fx/zh/tools/flow",
        "https://labs.google/fx/zh/tools/flow/project/*",
        "https://flow.google.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "webRequest",
    "offscreen",
    "power"
  ],
  "action": {
    "default_title": "Flow 批量生成：点击启用当前 Flow 页面",
    "default_icon": "assets/logo-128.png"
  },
  "host_permissions": [
    "https://labs.google/*",
    "https://labs.google/fx/zh/tools/flow",
    "https://labs.google/fx/zh/tools/flow/project/*",
    "https://flow.google.com/*"
  ],
  "icons": {
    "16": "assets/logo-16.png",
    "19": "assets/logo-19.png",
    "32": "assets/logo-32.png",
    "38": "assets/logo-38.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "resources": [
        "*"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "resources": [
        "assets/const-DweaA0In.js",
        "assets/index.ts-CASKl1qI.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://labs.google/fx/zh/tools/flow",
      "https://labs.google/fx/zh/tools/flow/project/*",
      "https://flow.google.com/*"
    ]
  }
}
